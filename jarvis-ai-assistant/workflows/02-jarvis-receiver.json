    {
      "id": "748b2624-2d38-4dd5-9d84-328e0d6f175c",
      "name": "Procesar Buffer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const datos = $('Preparar Datos').first().json;\nconst bufferRaw = $input.first().json.bufferValue;\nlet bufferData;\nif (bufferRaw && bufferRaw !== 'null' && String(bufferRaw).trim() !== '') {\n  try { bufferData = JSON.parse(String(bufferRaw)); } catch(e) {\n    bufferData = { fragments: [], lastUpdatedMs: Date.now(), ttlSeconds: 5 };\n  }\n} else {\n  bufferData = { fragments: [], lastUpdatedMs: Date.now(), ttlSeconds: 5 };\n}\nconst fragment = {\n  type: datos.messageType,\n  content: datos.content || null,\n  fileId: datos.fileId || null,\n  caption: datos.caption || null,\n  timestamp: datos.messageTimestamp,\n  messageId: datos.messageId,\n  awaitingContext: datos.messageType === 'photo' && !datos.caption\n};\nif (fragment.type === 'text') {\n  bufferData.fragments = bufferData.fragments.map(function(f) {\n    if (f.type === 'photo' && f.awaitingContext) {\n      return Object.assign({}, f, { awaitingContext: false, contextText: fragment.content });\n    }\n    return f;\n  });\n}\nbufferData.fragments.push(fragment);\nbufferData.lastUpdatedMs = Date.now();\nconst hasPhotoAwaiting = bufferData.fragments.some(function(f) { return f.awaitingContext; });\nbufferData.ttlSeconds = hasPhotoAwaiting ? 15 : 5;\nif (bufferData.fragments.length > 20) bufferData.fragments = bufferData.fragments.slice(-20);\nconst sanitizedContent = (datos.content || datos.caption || 'media').replace(/'/g, \"''\").substring(0, 4000);\nreturn [{ json: {\n  bufferKey: 'jarvis:buffer:' + datos.chatId + ':' + datos.userId,\n  bufferValue: JSON.stringify(bufferData),\n  chatId: datos.chatId,\n  userId: datos.userId,\n  dbUserId: datos.dbUserId,\n  messageType: datos.messageType,\n  sanitizedContent: sanitizedContent\n}}];"
      }
    },
