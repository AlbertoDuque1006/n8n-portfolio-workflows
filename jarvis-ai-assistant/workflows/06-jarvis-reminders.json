  "id": "crdXMsCs52rRZUxJ",
  "name": "JARVIS_REMINDERS",
  "description": "JARVIS scheduled reminder sender: polls every minute for due reminders in Postgres, formats them in Spanish, sends via Telegram bot, and marks as sent. Handles per-item processing so multiple simultaneous reminders each get their own message.",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 3
            }
          ]
        }
      },
      "id": "64f83d02-b3fd-40a8-ae85-7dba232c165a",
      "name": "Cada Minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT r.id, r.title, r.description, r.remind_at, r.recurrence, u.telegram_chat_id FROM jarvis_reminders r JOIN jarvis_users u ON r.user_id = u.id WHERE r.status = 'pending' AND r.remind_at <= NOW() ORDER BY r.remind_at ASC LIMIT 50",
        "options": {}
      },
      "id": "8123c850-664a-4dfb-871b-ac0532a255d8",
      "name": "Query Pending Reminders",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "IsrzB1nHT4dTM3sM",
          "name": "Postgres BD_Test"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json;\nconst d = new Date(r.remind_at);\nlet dateStr;\ntry { dateStr = d.toLocaleString('es-CO', { timeZone: 'America/Bogota', weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }); } catch(e) { dateStr = r.remind_at; }\nlet text = '⏰ *Recordatorio*\\n';\ntext += r.title || 'Sin título';\nif (r.description && r.description.trim()) text += '\\n_' + r.description.trim() + '_';\ntext += '\\n\\n🕒 ' + dateStr;\nreturn { json: { reminderId: r.id, chatId: r.telegram_chat_id, recurrence: r.recurrence || 'none', messageText: text } };"
      },
      "id": "8f01f0c5-dfff-47f7-847b-623841315bf5",
      "name": "Formatear Mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.messageText }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "cef50943-061b-43cb-879b-9818bbfa4819",
      "name": "Enviar Recordatorio Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        672,
        0
      ],
      "webhookId": "2ac76875-3761-45f0-9151-b764bf9df271",
      "credentials": {
        "telegramApi": {
          "id": "LpX5kW8pTmulcQSn",
          "name": "JARVIS - DAVID"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE jarvis_reminders SET status = 'sent', updated_at = NOW() WHERE id = {{ $('Formatear Mensaje').item.json.reminderId }} RETURNING id, title",
        "options": {}
      },
      "id": "d0d9f3c1-b7a6-4d7a-940b-014023602274",
      "name": "Marcar Enviado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        896,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "IsrzB1nHT4dTM3sM",
          "name": "Postgres BD_Test"
        }
      }
    }
  ],
