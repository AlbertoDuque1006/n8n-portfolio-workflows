    {
      "parameters": {
        "jsCode": "/**\n * n8n Function\n * Entrada esperada por item:\n * {\n *   \"query\": \"[{ \\\"QUERY\\\": \\\"SELECT ...;\\\", \\\"BD\\\": \\\"CienoGroup\\\" }]\"\n * }\n *\n * Comportamiento:\n * - Acepta `json.query` como string JSON, objeto o array.\n * - Emite 1 item por registro con:\n *     - JSON: el objeto { QUERY, BD } stringificado\n *     - sql:  QUERY en texto plano\n *     - bd:   nombre de la base de datos\n *     - nombre: etiqueta útil \"<BD>-<OPERACION>\"\n */\n\nfunction parseQuery(q) {\n  if (q == null) return [];\n  if (Array.isArray(q)) return q;          // ya es array\n  if (typeof q === 'object') return [q];   // es objeto\n\n  if (typeof q === 'string') {\n    const s = q.trim();\n    try {\n      const parsed = JSON.parse(s);\n      if (Array.isArray(parsed)) return parsed;\n      if (parsed && typeof parsed === 'object') return [parsed];\n    } catch {\n      // parseo relajado (quita comas colgantes típicas)\n      const relaxed = s.replace(/,\\s*]/g, ']').replace(/,\\s*}/g, '}');\n      try {\n        const parsed2 = JSON.parse(relaxed);\n        if (Array.isArray(parsed2)) return parsed2;\n        if (parsed2 && typeof parsed2 === 'object') return [parsed2];\n      } catch {\n        return [];\n      }\n    }\n  }\n  return [];\n}\n\nfunction toStringSafe(obj) {\n  if (typeof obj === 'string') return obj;\n  try { return JSON.stringify(obj); } catch { return String(obj); }\n}\n\nfunction inferOp(sql) {\n  const first = (sql || '').trim().split(/\\s+/)[0]?.toUpperCase() || '';\n  if (/^(SELECT|WITH)$/.test(first)) return 'SELECT';\n  if (/^INSERT$/.test(first)) return 'INSERT';\n  if (/^UPDATE$/.test(first)) return 'UPDATE';\n  if (/^DELETE$/.test(first)) return 'DELETE';\n  if (/^MERGE$/.test(first))  return 'MERGE';\n  if (/^(EXEC|EXECUTE|SP_EXECUTESQL)$/.test(first)) return 'EXEC';\n  if (/^ALTER$/.test(first))  return 'ALTER';\n  if (/^CREATE$/.test(first)) return 'CREATE';\n  if (/^DROP$/.test(first))   return 'DROP';\n  return first || 'SQL';\n}\n\nconst out = [];\n\nfor (const item of items) {\n  const lista = parseQuery(item.json?.query);\n\n  for (const e of lista) {\n    // Normalizar campos esperados\n    const sql = (e?.QUERY ?? '').toString().trim();\n    const bd  = (e?.BD ?? '').toString().trim();\n\n    const op = inferOp(sql);\n    const nombre = [bd || 'SINBD', op].join('-');\n\n    // Solo emitimos si hay al menos SQL o BD\n    if (!sql && !bd) continue;\n\n    const registro = { QUERY: sql, BD: bd };\n\n    out.push({\n      json: {\n        JSON: toStringSafe(registro),\n        sql,\n        bd,\n        nombre\n      }\n    });\n  }\n}\n\nreturn out;\n"
      },
