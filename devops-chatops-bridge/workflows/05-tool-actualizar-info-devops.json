      "parameters": {
        "jsCode": "/**\n * n8n Function\n * Toma cada item con `json.query` (string JSON, objeto o array) y\n * emite 1 item por registro con:\n *   - JSON: el objeto original (stringificado) con { Estado, CasoID, AssignedTo }\n *   - nombre: etiqueta \"<CasoID>-<Estado>\"\n *\n * Entrada ejemplo:\n * [\n *   {\n *     \"query\": \"[\\n  {\\n    \\\"Estado\\\": \\\"Done\\\",\\n    \\\"CasoID\\\": \\\"28365\\\",\\n    \\\"AssignedTo\\\": \\\"Alberto José Duque Gómez <alberto.duque@yourcompany.example>\\\"\\n  }\\n]\"\n *   }\n * ]\n */\n\nfunction parseQuery(q) {\n  if (q == null) return [];\n  if (Array.isArray(q)) return q;                 // ya es array\n  if (typeof q === 'object') return [q];          // objeto único\n\n  // Si viene como string -> intentar parsear\n  if (typeof q === 'string') {\n    const s = q.trim();\n    try {\n      const parsed = JSON.parse(s);\n      if (Array.isArray(parsed)) return parsed;\n      if (typeof parsed === 'object' && parsed) return [parsed];\n    } catch (e) {\n      // Intento de parseo \"relajado\": quitar comas colgantes\n      const relaxed = s.replace(/,\\s*]/g, ']').replace(/,\\s*}/g, '}');\n      try {\n        const parsed2 = JSON.parse(relaxed);\n        if (Array.isArray(parsed2)) return parsed2;\n        if (typeof parsed2 === 'object' && parsed2) return [parsed2];\n      } catch { /* vacío */ }\n    }\n  }\n  return [];\n}\n\nfunction toStringSafe(obj) {\n  if (typeof obj === 'string') return obj;\n  try { return JSON.stringify(obj); } catch { return String(obj); }\n}\n\nconst out = [];\n\nfor (const item of items) {\n  const lista = parseQuery(item.json?.query);\n\n  for (const e of lista) {\n    // Normalizaciones mínimas\n    const Estado      = (e?.Estado ?? '').toString().trim();\n    const CasoID      = (e?.CasoID ?? '').toString().trim();\n    const AssignedTo  = (e?.AssignedTo ?? '').toString().trim();\n\n    // Ensamblar objeto limpio SOLO con los campos requeridos\n    const registro = { Estado, CasoID, AssignedTo };\n\n    // Etiqueta \"nombre\": <ID>-<Estado>\n    const nombre = [\n      CasoID || 'SINID',\n      Estado || 'ESTADO'\n    ].join('-');\n\n    out.push({\n      json: {\n        JSON: toStringSafe(registro),\n        nombre\n      }\n    });\n  }\n}\n\nreturn out;\n"
      },
